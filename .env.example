APP_NAME=AlphaVendor
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.railway.app

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@alphavendor.com"
MAIL_FROM_NAME="${APP_NAME}"

PAPERFLY_BASE_URL=https://api.paperfly.com.bd
PAPERFLY_USERNAME=
PAPERFLY_PASSWORD=
PAPERFLY_KEY=
PAPERFLY_MERCHANT_CODE=

MIMSMS_APIKEY=
MIMSMS_USERNAME=
MIMSMS_SENDER_NAME=iSMS
MIMSMS_CAMPAIGN_NAME=

OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3
SMS_TEST_MODE=false
SMS_LOGGING_ENABLED=true
SMS_LOG_LEVEL=error
OTP_SMS_TEMPLATE="Your OTP is: {otp}. Valid for 15 minutes. Do not share this code."
